{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"FriendlyName": "MobFort",
	"Description": "Stylized unlit master materials for characters, designed for the mobile forward rendering path. You author the light instead of inheriting it, so a character reads the same anywhere. Gradient-driven diffuse, panoramic specular, two-palette rim and fake skin.",
	"Category": "Rendering",
	"CreatedBy": "Jared Taylor (Vaei)",
